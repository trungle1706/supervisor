{
  "$defs": {
    "AgentDetectors": {
      "additionalProperties": false,
      "description": "WP37 (ADR D23): per-agent override of ``config/detectors.yaml`` (``agents.<id>.detectors``).\n\n``preset`` is the agent's default sensitivity preset; ``enable`` / ``disable`` switch single\ndetectors; ``settings`` overrides detector settings by slug; ``skip_tools`` lists tools for\nwhich the gate runs no detector (verdict status ``skip``, a deterministic policy value).\nRead only when DETECTORS_ENABLED=1; the key is left out of the policy hash when unset, so a\npolicy file without it keeps the hash it had before WP37.",
      "properties": {
        "disable": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Disable",
          "type": "array"
        },
        "enable": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Enable",
          "type": "array"
        },
        "preset": {
          "anyOf": [
            {
              "enum": [
                "strict",
                "balanced",
                "lenient"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset"
        },
        "settings": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Settings",
          "type": "object"
        },
        "skip_tools": {
          "description": "Tools for which no detector runs (status skip). The loader refuses a tool whose risk class is money, credit or pii_export: a skip must not switch off GATE-DETECTOR-FAILED protection.",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Skip Tools",
          "type": "array"
        }
      },
      "title": "AgentDetectors",
      "type": "object"
    },
    "AgentManifest": {
      "additionalProperties": false,
      "properties": {
        "detectors": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentDetectors"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "host_type": {
          "default": "python",
          "title": "Host Type",
          "type": "string"
        },
        "initial_state": {
          "default": "SHADOW",
          "enum": [
            "RUNNING",
            "SHADOW"
          ],
          "title": "Initial State",
          "type": "string"
        },
        "model_family": {
          "default": "unknown",
          "title": "Model Family",
          "type": "string"
        },
        "monitors": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonitorBindings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "owner_team": {
          "minLength": 1,
          "title": "Owner Team",
          "type": "string"
        },
        "owner_user": {
          "minLength": 1,
          "title": "Owner User",
          "type": "string"
        },
        "plug_point": {
          "default": "sdk",
          "title": "Plug Point",
          "type": "string"
        },
        "risk_tier": {
          "default": "high",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Risk Tier",
          "type": "string"
        }
      },
      "required": [
        "name",
        "owner_user",
        "owner_team"
      ],
      "title": "AgentManifest",
      "type": "object"
    },
    "Aggregate": {
      "additionalProperties": false,
      "description": "Stateful window: sum ``field`` (or count calls) of allowed calls, plus this call.",
      "properties": {
        "also_by": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Also By",
          "type": "array"
        },
        "customer_arg": {
          "default": "customer_id",
          "title": "Customer Arg",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "fn": {
          "enum": [
            "sum",
            "count"
          ],
          "title": "Fn",
          "type": "string"
        },
        "group_by": {
          "enum": [
            "agent",
            "customer"
          ],
          "title": "Group By",
          "type": "string"
        },
        "limit": {
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "op": {
          "default": "gt",
          "enum": [
            "gt",
            "ge"
          ],
          "title": "Op",
          "type": "string"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "window_s": {
          "maximum": 2678400,
          "minimum": 1,
          "title": "Window S",
          "type": "integer"
        }
      },
      "required": [
        "fn",
        "window_s",
        "group_by",
        "limit"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "DailyBinding": {
      "additionalProperties": false,
      "description": "``monitors.session.daily`` (WP27 follow-up): a per-consumer window over a day, read by the\nbatch job only. It sees slow attacks and a rotating ``session_id`` (the sessions share one\nconsumer). Case only, never a pause. Off by default.",
      "properties": {
        "case_threshold_bp": {
          "default": 2500,
          "maximum": 10000,
          "minimum": 1,
          "title": "Case Threshold Bp",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "k": {
          "default": 3,
          "maximum": 8,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "window_s": {
          "default": 86400,
          "maximum": 604800,
          "minimum": 3600,
          "title": "Window S",
          "type": "integer"
        }
      },
      "title": "DailyBinding",
      "type": "object"
    },
    "DriftBinding": {
      "additionalProperties": false,
      "properties": {
        "baseline_windows": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Windows"
        },
        "min_baseline_windows": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Baseline Windows"
        },
        "min_n": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min N"
        },
        "window_s": {
          "anyOf": [
            {
              "minimum": 60,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window S"
        }
      },
      "title": "DriftBinding",
      "type": "object"
    },
    "FairnessBinding": {
      "additionalProperties": false,
      "properties": {
        "approve_values": {
          "items": {
            "type": "string"
          },
          "title": "Approve Values",
          "type": "array"
        },
        "decision_arg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Arg"
        },
        "decision_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Tool"
        },
        "protected_attribute_keys": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Protected Attribute Keys",
          "type": "object"
        },
        "subject_arg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Arg"
        }
      },
      "title": "FairnessBinding",
      "type": "object"
    },
    "MonitorBindings": {
      "additionalProperties": false,
      "properties": {
        "drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriftBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fairness": {
          "anyOf": [
            {
              "$ref": "#/$defs/FairnessBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "split_payment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SplitPaymentBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "MonitorBindings",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "description": "``arg`` is a dotted path into the tool args; ``ctx.`` reads the call context;\n``fact.<source>.<field>`` reads the system of record (missing record -> rule error).",
      "properties": {
        "arg": {
          "title": "Arg",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le",
            "in",
            "not_in",
            "matches",
            "absent",
            "present"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "arg",
        "op"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "Prior": {
      "additionalProperties": false,
      "description": "Earlier allowed call of ``tool`` with the same ``match_args`` values.\n\nmode ``present``: the rule matches when such a call happened within the window\n(for example a new payee added minutes ago). mode ``absent``: the rule matches\nwhen no such call happened (for example no documents fetched before a decision).",
      "properties": {
        "match_args": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Match Args",
          "type": "array"
        },
        "mode": {
          "enum": [
            "present",
            "absent"
          ],
          "title": "Mode",
          "type": "string"
        },
        "same_agent": {
          "default": false,
          "title": "Same Agent",
          "type": "boolean"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "within_s": {
          "maximum": 34560000,
          "minimum": 1,
          "title": "Within S",
          "type": "integer"
        }
      },
      "required": [
        "tool",
        "within_s",
        "match_args",
        "mode"
      ],
      "title": "Prior",
      "type": "object"
    },
    "QualityBinding": {
      "additionalProperties": false,
      "properties": {
        "reply_tools": {
          "items": {
            "type": "string"
          },
          "title": "Reply Tools",
          "type": "array"
        },
        "text_arg": {
          "default": "text",
          "title": "Text Arg",
          "type": "string"
        }
      },
      "title": "QualityBinding",
      "type": "object"
    },
    "RuleSpec": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "log",
            "alert",
            "block",
            "pause"
          ],
          "title": "Action",
          "type": "string"
        },
        "agent_scope": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "const": "*",
              "type": "string"
            }
          ],
          "title": "Agent Scope"
        },
        "aggregate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Aggregate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approvals": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Approvals",
          "type": "array"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fail_mode": {
          "anyOf": [
            {
              "enum": [
                "open",
                "closed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail Mode"
        },
        "id": {
          "pattern": "^[A-Z0-9][A-Z0-9_-]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "prior": {
          "anyOf": [
            {
              "$ref": "#/$defs/Prior"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regulation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regulation Ref"
        },
        "risk_class": {
          "enum": [
            "money",
            "credit",
            "pii_export",
            "read_only"
          ],
          "title": "Risk Class",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "when": {
          "$ref": "#/$defs/When"
        }
      },
      "required": [
        "id",
        "version",
        "description",
        "agent_scope",
        "action",
        "severity",
        "risk_class",
        "owner"
      ],
      "title": "RuleSpec",
      "type": "object"
    },
    "SessionBinding": {
      "additionalProperties": false,
      "description": "``agents.<id>.monitors.session`` (WP27): per-agent settings of the session monitor.\n\nEvery field is optional; a field left out takes the global ``SESSION_*`` setting or the\nbuilt-in default. ``pause_scope`` empty (the default) means case only, no pause.",
      "properties": {
        "cap_minor": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cap Minor"
        },
        "case_threshold_bp": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Threshold Bp"
        },
        "cooldown_s": {
          "anyOf": [
            {
              "maximum": 604800,
              "minimum": 60,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cooldown S"
        },
        "daily": {
          "anyOf": [
            {
              "$ref": "#/$defs/DailyBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "hit_bp": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hit Bp"
        },
        "k": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "K"
        },
        "pause_scope": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "money",
                  "credit"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pause Scope"
        },
        "pause_threshold_bp": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pause Threshold Bp"
        },
        "solo_signals": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solo Signals"
        },
        "weights": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights"
        },
        "window_s": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 60,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window S"
        }
      },
      "title": "SessionBinding",
      "type": "object"
    },
    "SplitPaymentBinding": {
      "additionalProperties": false,
      "properties": {
        "customer_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Key"
        },
        "payee_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payee Key"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        }
      },
      "title": "SplitPaymentBinding",
      "type": "object"
    },
    "ToolMatch": {
      "additionalProperties": false,
      "description": "Which tool names a rule applies to. YAML shorthand: ``tool: name`` means ``eq``.",
      "properties": {
        "op": {
          "default": "eq",
          "enum": [
            "eq",
            "in",
            "not_in",
            "matches"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "ToolMatch",
      "type": "object"
    },
    "When": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "All",
          "type": "array"
        },
        "any": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "Any",
          "type": "array"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolMatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "When",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admins": {
      "items": {
        "type": "string"
      },
      "title": "Admins",
      "type": "array"
    },
    "agents": {
      "additionalProperties": {
        "$ref": "#/$defs/AgentManifest"
      },
      "title": "Agents",
      "type": "object"
    },
    "policy_version": {
      "minimum": 1,
      "title": "Policy Version",
      "type": "integer"
    },
    "reviewers": {
      "items": {
        "type": "string"
      },
      "title": "Reviewers",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleSpec"
      },
      "title": "Rules",
      "type": "array"
    },
    "tools": {
      "additionalProperties": {
        "enum": [
          "money",
          "credit",
          "pii_export",
          "read_only"
        ],
        "type": "string"
      },
      "title": "Tools",
      "type": "object"
    }
  },
  "required": [
    "policy_version"
  ],
  "title": "Supervisor gateway policy",
  "type": "object"
}
