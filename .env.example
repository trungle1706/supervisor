# Copy to .env (cmd: copy .env.example .env). Notepad: choose "All files" or it saves .env.txt.
# Never put DATABRICKS_TOKEN here. Preflight fails if it is set (OAuth only).

# laptop | databricks_app | dev
SUPERVISOR_MODE=laptop
# Relative paths are resolved against the repo folder, once at startup.
DATA_DIR=data/local
SUPERVISOR_HOST=127.0.0.1
SUPERVISOR_PORT=8000

# Bank laptop: use the Windows certificate store (TLS inspection).
SSL_OS_TRUSTSTORE=0

# auto | sqlite | databricks_rest
SQL_BACKEND=auto
# Optional prefix for every table name (lowercase letters, digits, _). Live tests use one.
TABLE_PREFIX=

# Databricks (OAuth CLI profile on the laptop; the App gets a service principal).
DATABRICKS_HOST=https://FILL-ME-workspace-host
DATABRICKS_CONFIG_PROFILE=FILL-ME-profile
DATABRICKS_AUTH_TYPE=databricks-cli
DATABRICKS_WAREHOUSE_ID=FILL-ME-warehouse-id
# Or give the warehouse by name; it is resolved to an id at startup.
DATABRICKS_WAREHOUSE_NAME=FILL-ME-warehouse-name
DATABRICKS_CATALOG=FILL-ME-catalog
DATABRICKS_SCHEMA=FILL-ME-schema
DATABRICKS_RETRY_TIMEOUT_S=90
DATABRICKS_STATEMENT_DEADLINE_S=120

# LLM: OpenAI-compatible. Must be loopback unless LLM_ALLOW_REMOTE=1. Empty = mock judges.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_ALLOW_REMOTE=0
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_S=600
# LLM_API_KEY=FILL-ME-only-for-dev-box

# Evidence: HMAC key for tool-argument digests (args_hash / args_hmac in the chain).
# Empty = fixed dev key, labelled key id "dev" in every gate record. Set a long random value in production.
# ARGS_HASH_KEY=FILL-ME-random-secret
