# Supervisor v0.5.0 on the work laptop (Windows, offline, SQLite). Copy to .env:
#   copy .env.laptop.example .env
# Notepad: choose "All files" when you save, or it becomes .env.txt.
# Values that start with FILL-ME are yours to set. Lines that start with "# " are optional.
# Never put DATABRICKS_TOKEN here. Preflight fails if it is set (OAuth only).
# Every flag below is OFF by default in the code. The values here switch on what the
# ten-step story needs (docs/deploy/LAUNCH_LAPTOP.md). The older .env.example lists the rest.

# ---- Base ---------------------------------------------------------------------------------
SUPERVISOR_MODE=laptop
# The demo store. "demo seed" and "demo seed-systems" write here, "serve" reads it.
DATA_DIR=data/local/demo
SUPERVISOR_HOST=127.0.0.1
SUPERVISOR_PORT=8000
SQL_BACKEND=sqlite
# 1 = use the Windows certificate store (bank TLS inspection). 0 on a machine without it.
SSL_OS_TRUSTSTORE=1

# ---- Judge model (optional) ---------------------------------------------------------------
# Empty LLM_BASE_URL = mock judges, labelled "mock" on every screen. No model is needed.
LLM_BASE_URL=
# LLM_MODEL=FILL-ME-model-name
# LLM_API_KEY=FILL-ME-only-for-a-dev-box

# ---- Phase 4: governance (AI systems) -----------------------------------------------------
# AI systems, the intake form, assignment rules, Decision 33 classification, lifecycle.
GOVERNANCE_ENABLED=1
# Governance pages in the console (needs GOVERNANCE_ENABLED).
CONSOLE_SYSTEMS_ENABLED=1
# Sidebar with two sections (Governance, Supervisor) and the merged shell.
CONSOLE_NAV=sidebar
CONSOLE_NAV_SECTIONS=1
CONSOLE_NAV_V3=1
# Catalogue page: which guardian capabilities exist and whether each is on.
CONSOLE_CATALOG_ENABLED=1
# Risk of a system inherits from its agents, models, tools and data (inventory graph).
INVENTORY_ENABLED=1
# Events (block, detector failed, pack NO-GO, chain break) map to actions: incident, notify, ...
GOVERNANCE_ACTIONS_ENABLED=1
# Per-system guardian switches with the mandatory floor.
GUARDIAN_BINDINGS_ENABLED=1
# Outbound events are marked delivered by a stub; nothing is sent. Keep 0 unless you test it.
WEBHOOKS_ENABLED=0
# Mounts POST /mcp and GET /v1/kpis. Stock MCP desktop clients cannot sign HMAC yet.
MCP_SERVER_ENABLED=1
# AI pre-fill of open Decision 33 questions. Labelled "AI pre-fill". Needs a model; keep 0.
CLASSIFIER_AI_PREFILL=0
# Reports for the "Prove" step (transparency report, audit pack link).
TRANSPARENCY_ENABLED=1
CONSOLE_TRANSPARENCY_ENABLED=1
# Dry-run checks in the console.
CONSOLE_PLAYGROUND_ENABLED=1

# ---- Phase 4: scan of a Databricks workspace (needs a workspace; keep 0 on the laptop) ----
# Scan v2: serving endpoints, model versions, Genie spaces, jobs, Vector Search, UC functions,
# UC connections. Read-only calls. Live test kit item 12 checks the response shapes.
INVENTORY_SCAN_V2=0
# Turn an unmanaged App / agent endpoint / Genie space into a draft AI system. Owner lookup in
# config/governance.yaml (FILL-ME values there; no draft while the owner is FILL-ME).
INVENTORY_AUTOREGISTER=0
# catalog.schema,catalog.schema : Unity Catalog schemas whose tables and functions are listed.
# INVENTORY_SCAN_SCHEMAS=FILL-ME-catalog.FILL-ME-schema

# ---- Phase 5: guardian detectors ----------------------------------------------------------
# Detector layer (regex injection, DLP, secrets, document intake, guard model, moderation).
DETECTORS_ENABLED=1
# Documents in context.documents: PDF, DOCX, text, CSV. PDF needs the pypdf wheel (in
# requirements.txt). No OCR: scans are "uninspectable" and fail closed on risky tools.
DOCUMENT_INTAKE_ENABLED=1
# URL fetch for documents. Off: a URL in context is refused. On: HTTPS only, allow list below.
URL_FETCH_ENABLED=0
# Comma separated domains the fetch may reach. An empty list refuses every URL.
URL_FETCH_ALLOWLIST=FILL-ME-allowed-domain
# 1 lets the Playground dry run fetch URLs too. Keep 0.
PLAYGROUND_URL_FETCH=0
# Guard model (ML jailbreak and injection scoring). NO-GO until a real model run, so it stays
# off in config/detectors.yaml. These three pin the model when you choose one:
#   GUARD_MODEL_ADAPTER = auto | mock | classifier | chat   (auto = mock when no URL)
GUARD_MODEL_ADAPTER=auto
# GUARD_MODEL_URL=FILL-ME-guard-model-url
# GUARD_MODEL_NAME=FILL-ME-guard-model-id
# GUARD_MODEL_VERSION=FILL-ME-guard-model-revision
# GUARD_MODEL_API_KEY=FILL-ME-only-for-a-dev-box
GUARD_MODEL_TIMEOUT_MS=400
# 1 only with the written approval in the model card (docs/guard-model-decision.md).
GUARD_MODEL_FAIL_CLOSED_APPROVED=0
