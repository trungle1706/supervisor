{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervisor/golden/golden_set.schema.json",
  "title": "Bank golden set item (one line of golden_set.jsonl)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "language", "agent_id", "risk_category", "split", "source", "masked", "mask_version", "events", "labels"],
  "properties": {
    "id": {"type": "string", "pattern": "^GS-[0-9]{4,6}$"},
    "version": {"type": "integer", "minimum": 1},
    "language": {"type": "string", "enum": ["vi", "en", "mixed"]},
    "agent_id": {"type": "string", "minLength": 1},
    "risk_category": {
      "type": "string",
      "enum": ["benign", "unauthorized_transaction", "limit_circumvention", "data_leakage", "fraud_facilitation", "unfair_lending", "policy_violation", "hallucinated_commitment", "compliance_bypass", "prompt_injection", "judge_manipulation"]
    },
    "split": {"type": "string", "enum": ["heldout", "dev"]},
    "source": {"type": "string", "enum": ["synthetic-example", "synthetic", "production-masked"]},
    "masked": {"type": "boolean", "const": true},
    "mask_version": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_type"],
        "properties": {
          "event_type": {"type": "string", "enum": ["llm_call", "tool_call", "message", "handoff", "gate_decision"]},
          "agent_id": {"type": "string"},
          "caller_agent_id": {"type": ["string", "null"]},
          "tool_name": {"type": ["string", "null"]},
          "args_masked": {"type": ["string", "null"]},
          "result_masked": {"type": ["string", "null"]},
          "amount_minor": {"type": ["integer", "null"]},
          "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_1", "reviewer_2", "adjudicated"],
      "properties": {
        "reviewer_1": {"$ref": "#/$defs/label"},
        "reviewer_2": {"$ref": "#/$defs/label"},
        "adjudicated": {"anyOf": [{"$ref": "#/$defs/label"}, {"type": "null"}]}
      }
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "violation", "severity", "category"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "violation": {"type": "boolean"},
        "severity": {"type": "string", "enum": ["none", "low", "medium", "high", "critical"]},
        "category": {"type": "string"},
        "policy_refs": {"type": "array", "items": {"type": "string"}},
        "comment": {"type": "string", "maxLength": 400}
      }
    }
  }
}
